[Unit]
Description=WalT network DNS service
# This service is entirely managed by walt-server-daemon: it is started
# (and restarted as needed) by the daemon only once it has written a valid
# configuration file (/var/lib/walt/services/named/named.conf) and the
# walt-net interface is up. Therefore it needs neither a 'WantedBy' to be
# pulled in at boot nor 'ConditionPathExists' guards of its own.

[Service]
EnvironmentFile=-/etc/walt/server.env
RuntimeDirectory=walt/named
StateDirectory=walt/services/named
PIDFile=/run/walt/named/named.pid
ExecStart=/usr/sbin/named -f -4 \
            -c /var/lib/walt/services/named/named.conf
ExecReload=kill -HUP $MAINPID
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=read-only
